#!/usr/bin/python3
"""Make this computer able to hibernate: a swap space as large as its
memory, and the start after hibernating told where to find it (D119,
docs/dev/power.md section 6).

    kidux-hibernate-setup             this running computer: from
                                      kidux-session's postinst at every
                                      install and upgrade
    kidux-hibernate-setup --install   the system the installer is writing,
                                      run in its chroot, before the
                                      installer makes its initramfs and
                                      GRUB's configuration

A swap partition at least as large as the memory is used as it is.
Otherwise the swap file, `/swapfile`, is made, or made again, as large as
the memory rounded up to a whole GiB, where it fits with SPARE left free:
on `/`, or else on `/home`, as `/home/.kidux-swapfile`; and it is put in
`/etc/fstab`. Then the device and the file's place on it go to Debian's
initramfs, `/etc/initramfs-tools/conf.d/resume`, and to the kernel's
command line, `/etc/default/grub.d/91-kidux-resume.cfg`; on a running
computer the kernel is told too, so that it can hibernate without a
restart, and the initramfs and GRUB's configuration are made again.

Nothing is done where hibernating cannot work or would cost too much: under
Secure Boot's lockdown, which forbids it; in a chroot or an image being
built; with too little room on either filesystem; or when the computer is
already set up, which makes every later run do nothing. It never fails the
package's installation: what it did, or why not, is printed and logged.
"""

import os
import re
import subprocess
import sys
from pathlib import Path

GIB = 1024 ** 3
#: Free room left on the filesystem that holds the swap file.
SPARE = 4 * GIB
SWAPFILES = ("/swapfile", "/home/.kidux-swapfile")
RESUME_CONF = "etc/initramfs-tools/conf.d/resume"
GRUB_CONF = "etc/default/grub.d/91-kidux-resume.cfg"
HEADER = "# Written by kidux-hibernate-setup (kidux-session, docs/dev/power.md).\n"


# --- what to do: pure, so that it is tested as it is --------------------------

def memory_bytes(meminfo: str) -> int:
    """MemTotal from /proc/meminfo, in bytes; 0 when it is not there."""
    found = re.search(r"^MemTotal:\s+(\d+)\s+kB", meminfo or "", re.MULTILINE)
    return int(found.group(1)) * 1024 if found else 0


def swap_size(memory: int) -> int:
    """The swap file's size for `memory`: rounded up to a whole GiB."""
    return max(1, -(-memory // GIB)) * GIB


def swaps(text: str) -> list[tuple[str, str, int]]:
    """/proc/swaps as (name, type, bytes), zram left out."""
    found = []
    for line in (text or "").splitlines()[1:]:
        fields = line.split()
        if len(fields) >= 3 and not fields[0].startswith("/dev/zram"):
            found.append((fields[0].replace("\\040", " "), fields[1], int(fields[2]) * 1024))
    return found


def locked_down(text: str) -> bool:
    chosen = re.search(r"\[(\w+)\]", text or "")
    return chosen is not None and chosen.group(1) != "none"


def resume_set(conf: str) -> bool:
    """Whether conf.d/resume names a device, not `none`."""
    found = re.search(r"^RESUME=(\S+)", conf or "", re.MULTILINE)
    return found is not None and found.group(1).lower() not in ("none", "")


def choose_place(size: int, free: dict[str, int], existing: dict[str, int]) -> str | None:
    """Where the swap file goes: the first of SWAPFILES whose filesystem has
    room for `size` and SPARE, counting the room an existing swap file there
    gives back; None when neither has."""
    for path in SWAPFILES:
        if path not in free:
            continue
        if free[path] + existing.get(path, 0) >= size + SPARE:
            return path
    return None


def first_extent(filefrag: str) -> int | None:
    """The first physical block of a file from `filefrag -v`, in the
    filesystem's blocks; None when the output has none."""
    for line in (filefrag or "").splitlines():
        found = re.match(r"\s*0:\s+\d+\.\.\s*\d+:\s+(\d+)\.\.", line)
        if found:
            return int(found.group(1))
    return None


def resume_conf(uuid: str, offset: int | None) -> str:
    text = HEADER + f"RESUME=UUID={uuid}\n"
    if offset is not None:
        text += f"RESUME_OFFSET={offset}\n"
    return text


def grub_conf(uuid: str, offset: int | None) -> str:
    words = f"resume=UUID={uuid}" + (f" resume_offset={offset}" if offset is not None else "")
    return (HEADER + "# Where the start after hibernating finds the memory saved.\n"
            f'GRUB_CMDLINE_LINUX_DEFAULT="$GRUB_CMDLINE_LINUX_DEFAULT {words}"\n')


def fstab_with(fstab: str, path: str) -> str:
    """/etc/fstab with `path` as the one swap file of SWAPFILES in it."""
    kept = [line for line in (fstab or "").splitlines()
            if not (line.split()[:1] and line.split()[0] in SWAPFILES)]
    kept.append(f"{path} none swap defaults 0 0")
    return "\n".join(kept) + "\n"


# --- the machine ---------------------------------------------------------------

def say(message: str) -> None:
    print(f"kidux-hibernate-setup: {message}", flush=True)
    try:
        subprocess.run(["logger", "-t", "kidux-hibernate-setup", message], check=False,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        pass


def read(path) -> str:
    try:
        return Path(path).read_text()
    except OSError:
        return ""


def run(*argv: str) -> str:
    return subprocess.run(argv, check=True, capture_output=True, text=True).stdout


def write(path: Path, text: str, mode: int = 0o644) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.kidux")
    temporary.write_text(text)
    os.chmod(temporary, mode)
    os.replace(temporary, path)


def free_bytes(path: Path) -> int | None:
    """Free room on the filesystem `path` is on, or None when it is not a
    filesystem of its own here (/home not mounted apart is the same as /)."""
    try:
        stat = os.statvfs(path)
    except OSError:
        return None
    return stat.f_bavail * stat.f_frsize


def uuid_of(path: Path) -> str:
    return run("findmnt", "-n", "-o", "UUID", "-T", str(path)).strip()


def offset_of(path: Path) -> int:
    """The file's first block, in pages, as resume_offset counts it."""
    block = first_extent(run("filefrag", "-v", str(path)))
    if block is None:
        raise RuntimeError(f"filefrag found no extent in {path}")
    return block * os.statvfs(path).f_frsize // os.sysconf("SC_PAGE_SIZE")


def in_chroot() -> bool:
    try:
        return subprocess.run(["systemd-detect-virt", "--chroot"]).returncode == 0
    except OSError:
        return False


def swap_off(path: Path, running: bool) -> None:
    """A swap file in use taken out of use first; when the memory it holds
    has nowhere else to go, swapoff refuses, and nothing more is done."""
    in_use = any(name == str(path) for name, _, _ in swaps(read("/proc/swaps")))
    if running and in_use:
        done = subprocess.run(["swapoff", str(path)], capture_output=True, text=True)
        if done.returncode != 0:
            raise RuntimeError(f"{path} could not be taken out of use: {done.stderr.strip()}")


def make_swapfile(path: Path, size: int, running: bool) -> None:
    if path.exists():
        swap_off(path, running)
        path.unlink()
    run("fallocate", "-l", str(size), str(path))
    os.chmod(path, 0o600)
    run("mkswap", str(path))
    if running:
        run("swapon", str(path))


def tell_kernel(device: str, offset: int | None) -> None:
    """The running kernel's resume device and offset, as the initramfs sets
    them at a start: with them it can hibernate before a restart. Writing
    the device makes the kernel look for an image there, and a swap space
    just made has none."""
    if offset is not None:
        Path("/sys/power/resume_offset").write_text(str(offset))
    Path("/sys/power/resume").write_text(device)


def setup(installing: bool = False) -> str:
    root = Path("/")
    running = not installing
    if running and (in_chroot() or not Path("/run/systemd/system").is_dir()):
        return "not a running computer: nothing to do"
    if locked_down(read("/sys/kernel/security/lockdown")):
        return "Secure Boot's lockdown forbids hibernating: nothing to do"
    memory = memory_bytes(read("/proc/meminfo"))
    if not memory:
        return "the memory's size cannot be read: nothing to do"
    size = swap_size(memory)
    current = swaps(read("/proc/swaps")) if running else []
    resume_conf_path = root / RESUME_CONF
    configured = resume_set(read(resume_conf_path)) and (root / GRUB_CONF).exists()

    partition = next(((name, n) for name, kind, n in current
                      if kind == "partition" and n >= memory), None)
    if configured and (partition or any(kind == "file" and n >= memory
                                        for _, kind, n in current)):
        return "already able to hibernate: nothing to do"

    if partition:
        name = partition[0]
        uuid = run("blkid", "-s", "UUID", "-o", "value", name).strip()
        offset, device_file = None, Path(name)
    else:
        free, existing = {}, {}
        for place in SWAPFILES:
            target = root / place.lstrip("/")
            room = free_bytes(target.parent)
            if room is None:
                continue
            if place != SWAPFILES[0] and \
                    os.stat(target.parent).st_dev == os.stat(root).st_dev:
                continue                      # /home on the same filesystem as /
            free[place] = room
            if target.exists():
                existing[place] = target.stat().st_size
        place = choose_place(size, free, existing)
        if place is None:
            return (f"no room for a swap file of {size // GIB} GiB with "
                    f"{SPARE // GIB} GiB left free: nothing done")
        swapfile = root / place.lstrip("/")
        for other in SWAPFILES:
            stale = root / other.lstrip("/")
            if other != place and stale.exists():
                swap_off(stale, running)
                stale.unlink()
        make_swapfile(swapfile, size, running)
        write(root / "etc/fstab", fstab_with(read(root / "etc/fstab"), place))
        uuid, offset, device_file = uuid_of(swapfile), offset_of(swapfile), swapfile

    write(resume_conf_path, resume_conf(uuid, offset))
    write(root / GRUB_CONF, grub_conf(uuid, offset))
    if running:
        device = os.stat(device_file).st_dev if offset is not None else \
            os.stat(device_file).st_rdev
        tell_kernel(f"{os.major(device)}:{os.minor(device)}", offset)
        run("update-initramfs", "-u")
        if Path("/boot/grub/grub.cfg").exists():
            run("update-grub")
    where = device_file if offset is None else f"{device_file}, offset {offset}"
    return f"able to hibernate into {where} ({size // GIB} GiB)"


def main(args: list[str]) -> int:
    if args not in ([], ["--install"]):
        print(__doc__, file=sys.stderr)
        return 2
    if os.geteuid() != 0:
        print("kidux-hibernate-setup: run it as root", file=sys.stderr)
        return 1
    try:
        say(setup(installing=args == ["--install"]))
    except (OSError, RuntimeError, subprocess.CalledProcessError) as error:
        detail = getattr(error, "stderr", "") or ""
        say(f"could not finish, and hibernating may not work: {error} {detail}".strip())
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
