#: packages/kidux-greeter/kidux_greeter/words.py:72
msgid "French (France)"
msgstr "Francés (Francia)"

#: packages/kidux-greeter/kidux_greeter/words.py:73
msgid "Belgian"
msgstr "Belga"

#: packages/kidux-greeter/kidux_greeter/words.py:74
msgid "Canadian French"
msgstr "Francés canadiense"

#: packages/kidux-greeter/kidux_greeter/words.py:78
msgid "Children"
msgstr "Niños"

#: packages/kidux-greeter/kidux_greeter/words.py:79
msgid "Modules"
msgstr "Módulos"

#: packages/kidux-greeter/kidux_greeter/words.py:80
msgid "System"
msgstr "Sistema"

#: packages/kidux-greeter/kidux_greeter/words.py:81
#: packages/kidux-launcher/kidux_launcher/words.py:12
msgid "Close"
msgstr "Cerrar"

#: packages/kidux-greeter/kidux_greeter/words.py:82
msgid "Add a child"
msgstr "Añadir un niño"

#: packages/kidux-greeter/kidux_greeter/words.py:83
msgid "Name"
msgstr "Nombre"

#: packages/kidux-greeter/kidux_greeter/words.py:84
